DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password
DB_NAME=nombre_base_datos

# Firma los access tokens. Mínimo 32 caracteres (en producción el backend no
# arranca con menos). Generar: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Sesión (Fase 5). Valores por defecto:
# ACCESS_TOKEN_TTL=15m        vida del access token (en memoria del navegador)
# REFRESH_TOKEN_DIAS=7        inactividad máxima de una sesión
# SESION_MAX_DIAS=30          duración máxima de una sesión aunque se use a diario
# AUTH_CACHE_SEG=30           demora máxima para que una desactivación corte el acceso
# COOKIE_SECURE=              true/false; por defecto true solo con NODE_ENV=production
# TRUST_PROXY=loopback, linklocal, uniquelocal   de quién aceptar X-Forwarded-For
# API_RATE_LIMIT=1000         peticiones por minuto e IP
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,https://tu-dominio.com

# Seed: contraseña inicial del usuario administrador (solo al ejecutar `npm run seed`)
SEED_ADMIN_PASSWORD=

# Llaves QZ Tray (firma de impresión). Se montan por volumen, no van en la imagen.
QZ_KEYS_DIR=storage/keys

# Redis (la contraseña la define ./.env junto a docker-compose.yml y compose la inyecta)
REDIS_PASSWORD=

# Backups automáticos (backup_automatico.sh)
BACKUP_AGE_RECIPIENT=        # clave pública age1... (la privada NUNCA en el servidor)
BACKUP_DIR=./backups
BACKUP_RETENCION_DIAS=30
BACKUP_REMOTO=               # opcional: usuario@host:/backups/imprenta

# Rol con permisos DDL solo para el servicio `migrate` (ver MIGRATIONS.md).
# La API usa DB_USER, que debería ser un rol sin permisos de esquema.
DB_MIGRATOR_USER=
DB_MIGRATOR_PASSWORD=

# Cifra las credenciales SUNAT del emisor (clave SOL, client_secret) en la BD.
# 32 bytes en base64: openssl rand -base64 32
# Guarde una copia FUERA del servidor: sin ella hay que volver a ingresar las credenciales.
DATA_ENCRYPTION_KEY=
