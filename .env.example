DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password
DB_NAME=nombre_base_datos

JWT_SECRET=cambia_este_secreto_por_uno_seguro
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,https://tu-dominio.com

# Seed: contraseña inicial del usuario administrador (solo al ejecutar `npm run seed`)
SEED_ADMIN_PASSWORD=

# Llaves QZ Tray (firma de impresión). Se montan por volumen, no van en la imagen.
QZ_KEYS_DIR=storage/keys

# Redis (la contraseña la define ./.env junto a docker-compose.yml y compose la inyecta)
REDIS_PASSWORD=

# Backups automáticos (backup_automatico.sh)
BACKUP_AGE_RECIPIENT=        # clave pública age1... (la privada NUNCA en el servidor)
BACKUP_DIR=./backups
BACKUP_RETENCION_DIAS=30
BACKUP_REMOTO=               # opcional: usuario@host:/backups/imprenta

# Rol con permisos DDL solo para el servicio `migrate` (ver MIGRATIONS.md).
# La API usa DB_USER, que debería ser un rol sin permisos de esquema.
DB_MIGRATOR_USER=
DB_MIGRATOR_PASSWORD=
