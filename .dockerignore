# ── Git y meta ──────────────────────────────────────────────
.git
.gitignore
.dockerignore

# ── Secretos y entorno ──────────────────────────────────────
# El .env se inyecta por env_file en docker-compose, no se hornea.
.env
.env.example
# El certificado SUNAT y las llaves QZ llegan por el volumen ./storage →
# /app/storage (storage/certs, storage/keys). NO se hornean en la imagen.
storage/certs
storage/keys
**/printer/keys
*.pfx
*.p12
*.pem

# ── Datos de runtime (vienen del volumen storage) ───────────
storage/xml
storage/cdr
src/uploads

# ── Dependencias y build ────────────────────────────────────
node_modules
npm-debug.log*

# ── Ruido: scripts de diagnóstico y docs de incidencias ─────
check_*.js
fix_*.sh
fix_*.py
test_cors.sh
check_pitr_status.sh
import_xml_to_db.js
verify_imported_data.js
*.md

# ── Backups y varios ────────────────────────────────────────
create_backup.sh
backup_automatico.sh
backups
restore_backup.sh
*.DS_Store
